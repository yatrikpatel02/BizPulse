# Automatic ML Retraining thresholds
# Retraining triggers when BOTH conditions are met:
#   changed_records >= ML_RETRAIN_MIN_CHANGED_RECORDS
#   change_percentage >= ML_RETRAIN_CHANGE_THRESHOLD_PERCENT
# where changed_records = records_added + records_deleted + records_modified
# and change_percentage = changed_records / previously_trained_record_count * 100
ML_RETRAIN_CHANGE_THRESHOLD_PERCENT=10
ML_RETRAIN_MIN_CHANGED_RECORDS=100
# Existing ML pipeline's minimum training-data requirement (small dataset exception)
ML_RETRAIN_MIN_TRAINING_RECORDS=5
