-  }
-
-  /* Reset layout constraints that cause print clipping */
-  html, body, #root, #root > div {
-    height: auto !important;
-    overflow: visible !important;
-    background: white !important;
-    color: black !important;
-  }
-
-  /* Expand report container to full width and reset styles for paper output */
+  /* 1. Hide everything on the page using standard CSS print recipe */
+  body * {
+    visibility: hidden !important;
+  }
+
+  /* 2. Show only the printable report container and its nested children */
+  #report-print-area,
+  #report-print-area * {
+    visibility: visible !important;
+  }
+
+  /* 3. Position the report container at the top left of the printed paper */
+  #report-print-area {
+    position: absolute !important;
+    left: 0 !important;
+    top: 0 !important;
+    width: 100% !important;
+    max-width: 100% !important;
+    margin: 0 !important;
+    padding: 20px !important;
+    border: none !important;
+    background: transparent !important;
+    box-shadow: none !important;
+  }
+
+  /* 4. Force white background and black text on all printing elements */
+  #report-print-area * {
+    color: #000000 !important;
+    background-color: transparent !important;
+  }
+
+  /* 5. Force layout containers to allow scroll and height expansion to prevent clipping */
+  html, body, #root, #root > div, main, .print-modal-backdrop, .print-modal-content {
+    height: auto !important;
+    min-height: auto !important;
+    max-height: none !important;
+    overflow: visible !important;
+    background: white !important;
+    border: none !important;
+    box-shadow: none !important;
+    padding: 0 !important;
+    margin: 0 !important;
+  }
 }
